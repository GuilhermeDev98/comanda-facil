{
  "name": "comanda-facil",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @comanda-facil/api",
    "dev:web": "npm run dev --workspace @comanda-facil/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace @comanda-facil/api",
    "db:generate": "npm run db:generate --workspace @comanda-facil/api",
    "db:migrate": "npm run db:migrate --workspace @comanda-facil/api"
  },
  "engines": {
    "node": ">=22"
  }
}
